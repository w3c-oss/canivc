---
title: Reports
---
<div class="card-box" style="min-height: 450px">
  <h2>{{ title }}</h2>
  <div class="cards">
  {%- for report in results.all -%}
    <div class="card" onclick="location.href = '{{ report.respecConfig.shortName | slugify }}'">
      <div>
        <a class="title" href="{{ report.respecConfig.shortName | slugify }}">{{ report.respecConfig.title }}</a>
        <span class="description">{{ report.respecConfig.subtitle }}</span>
      </div>
      <div class="extra">
        {% assign specImplementations = results.specsImplementedBy | where: 'title', report.respecConfig.title | first %}
        <span class="label count">{{ specImplementations.implementations | size }}</span> implementations
      </div>
    </div>
  {%- endfor -%}
  </div>
</div>
