---
title: Implementations
---
<div class="card-box" style="min-height: 450px">
  <div class="card-head">
    <h2>{{ title }}</h2>
    <span class="info" tabindex="0" data-tooltip="Sorted alphabetically" aria-label="Sorted alphabetically">i</span>
  </div>
  <div class="grid two">
    <div>
      <ul class="link-list impl-list">
      {%- for imp in implementations -%}
        <li data-title="{{ imp[0] }}">
          <span class="item-text">
          {%- assign categories = results.testsByCompany[imp[0]] | keys | sort -%}
          <a href="{{ imp[0] | slugify }}">{{ imp[0] }}</a>
          {%- assign seen = '' -%}
          {%- for cat in categories -%}
            {%- assign lc = cat | downcase -%}
            {%- if lc contains 'issuer' -%}
              {%- assign labelName = 'Issuer' -%}
            {%- elsif lc contains 'verifier' -%}
              {%- assign labelName = 'Verifier' -%}
            {%- else -%}
              {%- assign labelName = 'Other' -%}
            {%- endif -%}
            {%- unless seen contains labelName -%}
              <span class="label">{{ labelName }}</span>
              {%- assign seen = seen | append: labelName | append: '|' -%}
            {%- endunless -%}
          {%- endfor -%}
          </span>
        </li>
      {%- endfor -%}
      </ul>
    </div>
    <div v-scope="store" id="imp-filter">
      <div class="card-box" style="box-shadow: none">
        <div class="filter-head">
          <h4>Filter by Implemented Specification</h4>
          <button class="button small" @click="clearFilter()">Clear Filter</button>
        </div>
        <ul class="filter-list">
          <li class="filter-item" v-for="spec in store.specs" @click="filterBySpec(spec.title, $el)">
            <span class="dot"></span>
            <span v-text="spec.title"></span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script type="module">
  import {createApp} from 'https://unpkg.com/petite-vue?module';
  createApp({
    store: {
      specs: {{ results.specsImplementedBy | jsonify }}
    },
    clearFilter() {
      document.querySelectorAll('.filter-list .filter-item').forEach((el) => {
        el.classList.remove('active');
      });
      document.querySelectorAll('.impl-list li').forEach((el) => {
        el.hidden = false;
      });
    },
    setSelected(title) {
      document.querySelectorAll('.filter-list .filter-item').forEach((el) => {
        if(el.children[1].textContent === title) {
          el.classList.add('active');
        } else {
          el.classList.remove('active');
        }
      });
    },
    filterBySpec(title, $el) {
      this.setSelected(title);
      const filtered = this.store.specs.filter(spec => {
        return spec.title === title;
      }).map(spec => spec.implementations).flat();
      // hide all specifications
      document.querySelectorAll('.impl-list li').forEach((el) => {
        el.hidden = true;
      });
      // show only filtered specifications
      const domFilter = '.impl-list li[data-title="' +
        filtered.join('"], .impl-list li[data-title="') + '"]';
      document.querySelectorAll(domFilter).forEach((el) => {
        el.hidden = false;
      });
      return filtered;
    }
  }).mount('#imp-filter');
</script>
